{
  "name": "parking-permits-ui",
  "version": "1.6.2",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write \"**/*.+(tsx|ts|json|scss|md)\"",
    "prettier": "prettier",
    "update-runtime-env": "tsx --tsconfig ./scripts/tsconfig.json scripts/update-runtime-env.ts",
    "start": "pnpm update-runtime-env && vite",
    "build": "pnpm update-runtime-env && vite build",
    "preview": "vite preview",
    "test": "NODE_ENV=test pnpm update-runtime-env && vitest run",
    "test:watch": "NODE_ENV=test pnpm update-runtime-env && vitest",
    "test:coverage": "NODE_ENV=test pnpm update-runtime-env && vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^3.11.2",
    "@sentry/react": "^11.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/geojson": "^7946.0.14",
    "@types/leaflet": "^1.9.12",
    "@types/lodash": "^4.17.7",
    "@types/node": "^18.19.34",
    "@types/query-string": "^6.3.0",
    "@types/uuid": "^9.0.8",
    "classnames": "^2.5.1",
    "date-fns": "^3.6.0",
    "geojson": "^0.5.0",
    "graphql": "^16.9.0",
    "hds-react": "^5.2.4",
    "i18next": "^23.12.2",
    "ibantools": "^4.5.1",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "query-string": "^9.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.0.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.5",
    "sass": "^1.77.8",
    "typescript": "~5.9.3",
    "uuid": "^14.0.0",
    "web-vitals": "^4.2.2"
  },
  "engines": {
    "node": "^24",
    "pnpm": ">=11.28.5"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "@city-of-helsinki/license-notices": "^0.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "husky": "9.1.4",
    "jsdom": "^30.1.3",
    "lint-staged": "^15.5.2",
    "prettier": "2.7.1",
    "prettier-plugin-organize-imports": "^2.3.4",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
